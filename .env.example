# Which Claude backend to use: "cli" (default, uses your Claude subscription via
# Claude Code CLI + CLAUDE_CODE_OAUTH_TOKEN) or "api" (direct Anthropic API, billed
# per-token via ANTHROPIC_API_KEY). Just change CLAUDE_MODE, no code edits needed.
CLAUDE_MODE=cli

# --- cli mode ---
CLAUDE_CODE_OAUTH_TOKEN=

# --- api mode ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- shared ---
SHEET_ID=
SHEET_CATALOG_TAB=
ORDERS_WEBHOOK_URL=
OWNER_NOTIFY_NUMBER=
